generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  name                  String
  // User traits
  personalityType       String?       // MBTI or similar
  communicationStyle    String?       // Direct, Passive, Aggressive, etc.
  loveLanguages        String[]      // Quality Time, Acts of Service, etc.
  coreValues           String[]      // Family, Career, Personal Growth, etc.
  conflictStyle        String?       // Avoiding, Accommodating, Compromising, etc.
  attachmentStyle      String?       // Secure, Anxious, Avoidant, etc.
  stressors            String[]      // Work, Family, Health, etc.
  interests            String[]

  relationships         Relationship[] @relation("Partner1")
  relationshipsAsPartner2 Relationship[] @relation("Partner2")
  sessions              Session[]
  subscription          Subscription?  // One-to-one relation with subscription
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Subscription {
  id                   String           @id @default(cuid())
  user                 User             @relation(fields: [userId], references: [id])
  userId               String           @unique
  status               SubscriptionStatus
  plan                 Plan             @relation(fields: [planId], references: [id])
  planId               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean         @default(false)
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?         @unique
  credits              CreditBalance?   // One-to-one relation with credit balance
  creditTransactions   CreditTransaction[]
  usageRecords         UsageRecord[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([userId, planId], name: "userId_planId")

}
// Delete and transform to type to validate types/constants plans
model Plan {
  id                 String         @id @default(cuid())
  name               String         // e.g., "Basic", "Pro", "Enterprise"
  description        String
  price              Float          // Monthly price
  features           Json           // Array of features included
  sessionLimit       Int            // Monthly session limit
  relationshipLimit  Int            // Maximum number of relationships
  monthlyCredits     Int            // Credits awarded monthly
  subscriptions      Subscription[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model CreditBalance {
  id              String         @id @default(cuid())
  subscription    Subscription   @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String        @unique
  amount          Int           // Current credit balance
  lastRefillAt    DateTime      // Last time credits were refilled
  nextRefillAt    DateTime      // Next scheduled refill date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CreditTransaction {
  id              String         @id @default(cuid())
  subscription    Subscription   @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String
  amount          Int           // Positive for credits added, negative for credits used
  type            CreditTransactionType
  description     String
  metadata        Json?         // Additional transaction details
  createdAt       DateTime      @default(now())
}

model UsageRecord {
  id              String       @id @default(cuid())
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String
  type            UsageType
  quantity        Int
  creditsUsed     Int         // Number of credits consumed by this usage
  timestamp       DateTime     @default(now())
}

enum CreditTransactionType {
  MONTHLY_REFILL
  USAGE
  BONUS
  ADJUSTMENT
  EXPIRATION
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

enum UsageType {
  SESSION
  RELATIONSHIP
  ANALYSIS
}

// Existing models remain unchanged...
model Relationship {
  id          String    @id @default(cuid())
  name        String
  partner1    User      @relation("Partner1", fields: [partner1Id], references: [id])
  partner1Id  String
  partner2    User      @relation("Partner2", fields: [partner2Id], references: [id])
  partner2Id  String
  status      String
  sessions    Session[]
  analyses    Analysis[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([partner1Id, partner2Id])
}

model Session {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  relationship   Relationship @relation(fields: [relationshipId], references: [id])
  relationshipId String
  name           String
  description    String
  sessionType    String
  status         String
  messages       Message[]
  analyses       Analysis[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, name])
}

model Message {
  id        String   @id @default(cuid())
  content   String   
  role      String
  metadata  Json?
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())
}

model Analysis {
  id             String       @id @default(cuid())
  relationship   Relationship @relation(fields: [relationshipId], references: [id])
  relationshipId String
  sessions       Session[]
  type           String
  content        Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ConsolidatedAnalysis {
  id              String   @id @default(cuid())
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  analysis        Json
  
  @@index([userId])
}